  "screens": [
    {"id": 1, "section": "hook", "start": 0, "end": 60, "text": "妈妈离开了房间。", "highlights": [], "pulse": {"bpm": [66, 70], "vol": 0}, "sfx": [{"name": "whoosh", "at": 2, "vol": 0.25}, {"name": "click", "at": 44, "vol": 0.8}]},
    {"id": 2, "section": "hook", "start": 60, "end": 135, "text": "这个孩子没哭，也没去找。", "highlights": [], "pulse": {"bpm": [70, 80], "vol": 0.25}, "sfx": [{"name": "particles", "at": 18, "vol": 0.25}]},
    {"id": 3, "section": "hook", "start": 135, "end": 210, "text": "但TA的心跳，在加速。", "highlights": ["心跳"], "style": "slam", "pulse": {"bpm": [90, 150], "vol": 0.95, "beep": true}, "sfx": [{"name": "hit", "at": 7, "vol": 0.9}, {"name": "hit2", "at": 16, "vol": 0.55}]},
    {"id": 4, "section": "hook", "start": 210, "end": 270, "text": "表面平静，身体紧张。", "highlights": ["表面", "身体"], "pulse": {"bpm": [150, 165], "vol": 1.0, "beep": true}, "sfx": [{"name": "pluck", "at": 6, "vol": 0.35}, {"name": "pluck", "at": 24, "vol": 0.35}]},
    {"id": 5, "section": "question", "start": 270, "end": 330, "text": "很多年后，TA长大了。", "highlights": [], "pulse": {"bpm": [110, 72], "vol": 0.3}, "sfx": [{"name": "whoosh_up", "at": 0, "vol": 0.6}, {"name": "lock", "at": 22, "vol": 0.55}, {"name": "lock", "at": 34, "vol": 0.55}]},
    {"id": 6, "section": "question", "start": 330, "end": 390, "text": "有人想靠近TA。", "highlights": [], "pulse": {"bpm": [72, 76], "vol": 0.25}, "sfx": [{"name": "pluck", "at": 8, "vol": 0.45}]},
    {"id": 7, "section": "question", "start": 390, "end": 450, "text": "TA明明在乎，", "highlights": ["在乎"], "pulse": {"bpm": [80, 118], "vol": 0.7}},
    {"id": 8, "section": "question", "start": 450, "end": 540, "text": "为什么你越靠近，TA越想逃？", "highlights": ["逃"], "style": "slam", "pulse": {"bpm": [118, 124], "vol": 0.45}, "sfx": [{"name": "whoosh", "at": 0, "vol": 0.5}, {"name": "hit", "at": 7, "vol": 0.9}, {"name": "hit2", "at": 22, "vol": 0.8}, {"name": "whoosh", "at": 40, "vol": 0.4}]},
    {"id": 9, "section": "question", "start": 540, "end": 615, "text": "回避型依恋", "highlights": [], "style": "title", "sfx": [{"name": "riser", "at": -24, "vol": 0.5}, {"name": "boom", "at": 4, "vol": 1.0}]},
    {"id": 10, "section": "what", "start": 615, "end": 675, "text": "常见的样子是这样：", "highlights": [], "sfx": [{"name": "whoosh", "at": 0, "vol": 0.55}, {"name": "tick", "at": 22, "vol": 0.5}, {"name": "tick", "at": 27, "vol": 0.5}, {"name": "tick", "at": 32, "vol": 0.5}, {"name": "tick", "at": 37, "vol": 0.5}]},
    {"id": 11, "section": "what", "start": 675, "end": 750, "text": "关系一变近，TA就降温。", "highlights": ["降温"], "sfx": [{"name": "whoosh", "at": 0, "vol": 0.3}, {"name": "hiss_down", "at": 20, "vol": 0.6}]},
    {"id": 12, "section": "what", "start": 750, "end": 840, "text": "问TA怎么了，总是“我没事”。", "highlights": ["“我没事”"], "sfx": [{"name": "whoosh", "at": 0, "vol": 0.3}, {"name": "pluck", "at": 16, "vol": 0.3}, {"name": "pluck", "at": 24, "vol": 0.3}, {"name": "pluck", "at": 32, "vol": 0.3}, {"name": "flatline", "at": 40, "vol": 0.35}]},
    {"id": 13, "section": "what", "start": 840, "end": 915, "text": "遇到难事，习惯自己扛。", "highlights": ["习惯"], "sfx": [{"name": "whoosh", "at": 0, "vol": 0.3}, {"name": "thud", "at": 14, "vol": 0.8}, {"name": "thud", "at": 26, "vol": 0.8}, {"name": "thud", "at": 38, "vol": 0.8}]},
    {"id": 14, "section": "what", "start": 915, "end": 990, "text": "吵完架，TA会先消失一阵。", "highlights": ["消失"], "sfx": [{"name": "whoosh", "at": 0, "vol": 0.3}, {"name": "zap", "at": 26, "vol": 0.7}]},
    {"id": 15, "section": "what", "start": 990, "end": 1050, "text": "但这不是一个标签。", "highlights": ["标签"], "sfx": [{"name": "thud", "at": 16, "vol": 0.9}, {"name": "whoosh_up", "at": 32, "vol": 0.45}]},
    {"id": 16, "section": "what", "start": 1050, "end": 1125, "text": "它是一个程度，不是诊断。", "highlights": ["程度"], "style": "slam", "sfx": [{"name": "hit", "at": 7, "vol": 0.9}, {"name": "hit2", "at": 18, "vol": 0.6}, {"name": "particles", "at": 10, "vol": 0.45}]},
    {"id": 17, "section": "what", "start": 1125, "end": 1215, "text": "也和回避型人格障碍是两回事。", "highlights": ["回避型人格障碍"], "sfx": [{"name": "lock", "at": 18, "vol": 0.7}]},
    {"id": 18, "section": "origin", "start": 1215, "end": 1275, "text": "这种冷，是从哪来的？", "highlights": []},
    {"id": 19, "section": "origin", "start": 1275, "end": 1365, "text": "研究发现，它常和早年经历有关。", "highlights": ["早年经历"]},
    {"id": 20, "section": "origin", "start": 1365, "end": 1440, "text": "TA哭，TA伸手，想要被抱。", "highlights": ["被抱"]},
    {"id": 21, "section": "origin", "start": 1440, "end": 1530, "text": "得到的却常常是冷淡，或被推开。", "highlights": ["冷淡"]},
    {"id": 22, "section": "origin", "start": 1530, "end": 1590, "text": "一次，两次，很多次。", "highlights": []},
    {"id": 23, "section": "origin", "start": 1590, "end": 1665, "text": "TA慢慢学会了一件事：", "highlights": []},
    {"id": 24, "section": "origin", "start": 1665, "end": 1740, "text": "需要别人，只会更失望。", "highlights": ["需要别人"]},
    {"id": 25, "section": "origin", "start": 1740, "end": 1800, "text": "那就不需要好了。", "highlights": ["不需要"]},
    {"id": 26, "section": "origin", "start": 1800, "end": 1890, "text": "把信号关掉，就不会再被拒绝。", "highlights": ["关掉"]},
    {"id": 27, "section": "origin", "start": 1890, "end": 1980, "text": "在当时，这是一种聪明的保护。", "highlights": ["聪明的保护"]},
    {"id": 28, "section": "origin", "start": 1980, "end": 2040, "text": "当然，原因不止一个。", "highlights": []},
    {"id": 29, "section": "origin", "start": 2040, "end": 2130, "text": "天生气质、后来的经历，也有影响。", "highlights": []},
    {"id": 30, "section": "express", "start": 2130, "end": 2220, "text": "可是，信号关掉了，需要还在吗？", "highlights": ["需要"]},
    {"id": 31, "section": "express", "start": 2220, "end": 2280, "text": "回到开头那个实验。", "highlights": []},
    {"id": 32, "section": "express", "start": 2280, "end": 2385, "text": "研究者测了孩子们的心率和压力激素。", "highlights": ["心率", "压力激素"]},
    {"id": 33, "section": "express", "start": 2385, "end": 2475, "text": "身体的紧张，并不比哭的孩子少。", "highlights": ["少"]},
    {"id": 34, "section": "express", "start": 2475, "end": 2550, "text": "成年人身上，也有类似发现。", "highlights": []},
    {"id": 35, "section": "express", "start": 2550, "end": 2625, "text": "当TA脑子被别的事占满，", "highlights": []},
    {"id": 36, "section": "express", "start": 2625, "end": 2715, "text": "被压下去的分手念头，会反弹回来。", "highlights": ["分手念头"]},
    {"id": 37, "section": "express", "start": 2715, "end": 2805, "text": "TA关掉的是表达，不是需要。", "highlights": ["表达", "需要"]},
    {"id": 38, "section": "cycle", "start": 2805, "end": 2865, "text": "所以，回到那个问题。", "highlights": []},
    {"id": 39, "section": "cycle", "start": 2865, "end": 2970, "text": "如果靠近TA的，恰好是个怕被丢下的人——", "highlights": ["怕被丢下"]},
    {"id": 40, "section": "cycle", "start": 2970, "end": 3045, "text": "对方越不安，就越想追。", "highlights": ["追"]},
    {"id": 41, "section": "cycle", "start": 3045, "end": 3105, "text": "TA越被追，就越想躲。", "highlights": ["躲"]},
    {"id": 42, "section": "cycle", "start": 3105, "end": 3165, "text": "追，躲，再追，再躲。", "highlights": []},
    {"id": 43, "section": "cycle", "start": 3165, "end": 3255, "text": "两个人都很累，也都在害怕。", "highlights": ["害怕"]},
    {"id": 44, "section": "cycle", "start": 3255, "end": 3345, "text": "一个怕被丢下，一个怕再被拒绝。", "highlights": ["被丢下", "再被拒绝"]},
    {"id": 45, "section": "cycle", "start": 3345, "end": 3420, "text": "TA想逃，不是因为不在乎，", "highlights": []},
    {"id": 46, "section": "cycle", "start": 3420, "end": 3525, "text": "而是靠近会唤醒那个被关掉的信号。", "highlights": ["靠近"]},
    {"id": 47, "section": "change", "start": 3525, "end": 3615, "text": "好消息是：依恋风格，不是终身判决。", "highlights": ["不是终身判决"]},
    {"id": 48, "section": "change", "start": 3615, "end": 3690, "text": "在稳定、可预期的关系里，", "highlights": ["稳定、可预期"]},
    {"id": 49, "section": "change", "start": 3690, "end": 3765, "text": "防御可以一层层松开。", "highlights": ["松开"]},
    {"id": 50, "section": "change", "start": 3765, "end": 3825, "text": "如果你是回避的一方：", "highlights": []},
    {"id": 51, "section": "change", "start": 3825, "end": 3915, "text": "试着先说出一小部分需要。", "highlights": ["一小部分"]},
    {"id": 52, "section": "change", "start": 3915, "end": 3990, "text": "想躲的时候，别直接消失。", "highlights": []},
    {"id": 53, "section": "change", "start": 3990, "end": 4095, "text": "说一句：我需要静一静，一小时后回来。", "highlights": ["我需要静一静，一小时后回来"]},
    {"id": 54, "section": "change", "start": 4095, "end": 4185, "text": "爱TA的人：给空间，但要稳稳地在。", "highlights": ["给空间", "稳稳地在"]},
    {"id": 55, "section": "change", "start": 4185, "end": 4290, "text": "困扰很深时，可以找心理咨询师聊聊。", "highlights": ["心理咨询师"]},
    {"id": 56, "section": "ending", "start": 4290, "end": 4365, "text": "所以，下次TA又沉默的时候——", "highlights": []},
    {"id": 57, "section": "ending", "start": 4365, "end": 4440, "text": "记得，TA不是没有心跳。", "highlights": ["心跳"]},
    {"id": 58, "section": "ending", "start": 4440, "end": 4545, "text": "只是很早就学会了，不让人看见。", "highlights": ["不让人看见"]},
    {"id": 59, "section": "ending", "start": 4545, "end": 4620, "text": "本片仅为科普，不构成诊断或治疗建议", "highlights": [], "style": "note"}
  ]
}
