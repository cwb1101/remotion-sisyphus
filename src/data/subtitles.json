{
  "_doc": "字幕定稿：唯一数据源。start/end 为帧（30fps，end 不含）；cues 与 sfx.at 为相对本屏 start 的帧偏移，at 也可写 cue 名。改字幕、改时间只改这个文件。",
  "fps": 30,
  "width": 1920,
  "height": 1080,
  "colors": {"text": "#FFFFFF", "amber": "#FFB547", "cyan": "#5CE1E6"},
  "sfxPeakDbfs": {"weak": -24, "mid": -16, "strong": -8},
  "screens": [
    {"id": 1, "start": 0, "end": 90, "section": "hook", "text": "天花板，每年都低一点。", "highlights": [], "cues": {"drop1": 20, "drop2": 45, "drop3": 70}, "sfx": [{"type": "thud", "level": "weak", "at": "drop1"}, {"type": "thud", "level": "weak", "at": "drop2"}, {"type": "thud", "level": "weak", "at": "drop3"}]},
    {"id": 2, "start": 90, "end": 150, "section": "hook", "text": "你每年都说：还能忍。", "highlights": [{"word": "还能忍", "color": "amber"}], "cues": {"raise": 10}, "sfx": [{"type": "pluck", "level": "weak", "at": "raise"}]},
    {"id": 3, "start": 150, "end": 240, "section": "hook", "text": "可忍耐，从来不是免费的。", "highlights": [{"word": "不是免费的", "color": "amber"}], "cues": {"slam": 6, "word": 12}, "sfx": [{"type": "heavyHit", "level": "strong", "at": "slam"}]},
    {"id": 4, "start": 240, "end": 345, "section": "question", "text": "明明很痛苦，为什么还是不想改变？", "highlights": [{"word": "不想改变", "color": "cyan"}], "cues": {"pull": 0, "door": 15}, "sfx": [{"type": "glide", "level": "weak", "at": "pull"}]},
    {"id": 5, "start": 345, "end": 435, "section": "question", "text": "常见的回答是：你还不够痛。", "highlights": [{"word": "还不够痛", "color": "amber"}], "cues": {"rise": 0, "stall": 55}, "sfx": [{"type": "riser", "level": "weak", "at": "rise", "dur": 55}]},
    {"id": 6, "start": 435, "end": 510, "section": "question", "text": "但这句话，只说对了一半。", "highlights": [], "cues": {"slam": 6, "slash": 36}, "sfx": [{"type": "pluck", "level": "mid", "at": "slam"}, {"type": "glide", "level": "mid", "at": "slash"}]},
    {"id": 7, "start": 510, "end": 615, "section": "choice", "text": "我们以为，自己在选痛苦还是改变。", "highlights": [], "cues": {"morph": 0}, "sfx": [{"type": "pad", "level": "weak", "at": 0, "dur": 165}]},
    {"id": 8, "start": 615, "end": 690, "section": "choice", "text": "其实，真正的选择题是——", "highlights": [], "cues": {"flip": 0, "scatter": 25}, "sfx": [{"type": "glide", "level": "weak", "at": "scatter"}]},
    {"id": 9, "start": 690, "end": 780, "section": "choice", "text": "熟悉的痛，还是未知的路。", "highlights": [{"word": "熟悉的痛", "color": "amber"}, {"word": "未知的路", "color": "cyan"}], "cues": {"word1": 10, "word2": 24, "walk": 12}, "sfx": [{"type": "chord", "level": "mid", "at": "word1"}]},
    {"id": 10, "start": 780, "end": 855, "section": "choice", "text": "大多数人，本能会选前者。", "highlights": [], "cues": {"back": 0, "turn": 20}, "sfx": [{"type": "pluck", "level": "weak", "at": "turn"}]},
    {"id": 11, "start": 855, "end": 945, "section": "choice", "text": "不是现在很好，是现在可以预测。", "highlights": [{"word": "可以预测", "color": "amber"}], "cues": {"word": 12, "steps": 0}, "sfx": [{"type": "tick", "level": "weak", "at": "steps", "repeat": {"every": 15, "count": 6}}]},
    {"id": 12, "start": 945, "end": 1005, "section": "name", "text": "这种倾向，有个名字：", "highlights": [], "cues": {}, "sfx": [{"type": "riser", "level": "weak", "at": 0, "dur": 55}]},
    {"id": 13, "start": 1005, "end": 1095, "section": "name", "text": "现状偏差。", "highlights": [{"word": "现状偏差", "color": "amber"}], "cues": {"slam": 4}, "sfx": [{"type": "heavyHit", "level": "strong", "at": "slam"}]},
    {"id": 14, "start": 1095, "end": 1185, "section": "name", "text": "1988年，两位学者提出：", "highlights": [], "cues": {}, "sfx": [{"type": "glide", "level": "weak", "at": 0}]},
    {"id": 15, "start": 1185, "end": 1275, "section": "name", "text": "同样的选项，一旦被设成“现状”，", "highlights": [], "cues": {}, "sfx": [{"type": "tick", "level": "weak", "at": 0, "repeat": {"every": 20, "count": 4}}]},
    {"id": 16, "start": 1275, "end": 1350, "section": "name", "text": "选它的人就会变多。", "highlights": [], "cues": {}, "sfx": [{"type": "pluck", "level": "weak", "at": 6}]},
    {"id": 17, "start": 1350, "end": 1440, "section": "examples", "text": "你知道这份工作让你痛苦，", "highlights": [], "cues": {}, "sfx": [{"type": "tick", "level": "weak", "at": 0, "repeat": {"every": 15, "count": 5}}]},
    {"id": 18, "start": 1440, "end": 1530, "section": "examples", "text": "却不知道，辞职以后能做什么。", "highlights": [], "cues": {}, "sfx": [{"type": "glide", "level": "weak", "at": 10}]},
    {"id": 19, "start": 1530, "end": 1620, "section": "examples", "text": "你知道一段关系在消耗你，", "highlights": [], "cues": {}, "sfx": [{"type": "pluckDown", "level": "weak", "at": 8}]},
    {"id": 20, "start": 1620, "end": 1710, "section": "examples", "text": "却不确定，离开后会不会更好。", "highlights": [], "cues": {}, "sfx": [{"type": "glide", "level": "weak", "at": 10}]},
    {"id": 21, "start": 1710, "end": 1815, "section": "examples", "text": "于是，一边抱怨现在，一边维护现在。", "highlights": [{"word": "抱怨", "color": "amber"}, {"word": "维护", "color": "amber"}], "cues": {"punch": 10, "patch": 50}, "sfx": [{"type": "thud", "level": "mid", "at": "punch"}, {"type": "pluck", "level": "weak", "at": "patch"}]},
    {"id": 22, "start": 1815, "end": 1890, "section": "examples", "text": "痛苦只要稳定、还扛得住，", "highlights": [], "cues": {}, "sfx": [{"type": "pad", "level": "weak", "at": 0, "dur": 75}]},
    {"id": 23, "start": 1890, "end": 1980, "section": "examples", "text": "就可能比未知更让人安心。", "highlights": [{"word": "未知", "color": "cyan"}], "cues": {}, "sfx": [{"type": "pluck", "level": "weak", "at": 10}]},
    {"id": 24, "start": 1980, "end": 2085, "section": "threshold", "text": "剧烈的改变，往往不在刚不满时发生，", "highlights": [], "cues": {}, "sfx": [{"type": "riser", "level": "weak", "at": 0, "dur": 100}]},
    {"id": 25, "start": 2085, "end": 2175, "section": "threshold", "text": "而在再也忍不下去的那天。", "highlights": [{"word": "再也忍不下去", "color": "amber"}], "cues": {"cross": 20}, "sfx": [{"type": "thud", "level": "mid", "at": "cross"}]},
    {"id": 26, "start": 2175, "end": 2295, "section": "threshold", "text": "不是未来变清晰了，是过去过不下去了。", "highlights": [], "cues": {}, "sfx": [{"type": "sineGlideDown", "level": "mid", "at": 10}]},
    {"id": 27, "start": 2295, "end": 2385, "section": "ledger", "text": "我们常怪自己懒、软弱、没行动力。", "highlights": [], "cues": {"tag1": 10, "tag2": 30, "tag3": 50}, "sfx": [{"type": "thud", "level": "weak", "at": "tag1"}, {"type": "thud", "level": "weak", "at": "tag2"}, {"type": "thud", "level": "weak", "at": "tag3"}]},
    {"id": 28, "start": 2385, "end": 2475, "section": "ledger", "text": "但更可能的是：你只算了一本账。", "highlights": [], "cues": {}, "sfx": [{"type": "glide", "level": "weak", "at": 6}]},
    {"id": 29, "start": 2475, "end": 2580, "section": "ledger", "text": "改变的代价今天就付，所以看得见。", "highlights": [{"word": "改变的代价", "color": "cyan"}], "cues": {"drop": 15}, "sfx": [{"type": "thud", "level": "mid", "at": "drop"}]},
    {"id": 30, "start": 2580, "end": 2685, "section": "ledger", "text": "留下的代价分到以后，所以被忽略。", "highlights": [{"word": "留下的代价", "color": "amber"}], "cues": {}, "sfx": [{"type": "sand", "level": "weak", "at": 0, "dur": 105, "density": 0.4}]},
    {"id": 31, "start": 2685, "end": 2745, "section": "ledger", "text": "辞职，会失去稳定；", "highlights": [], "cues": {"drop": 10}, "sfx": [{"type": "thud", "level": "weak", "at": "drop"}]},
    {"id": 32, "start": 2745, "end": 2835, "section": "ledger", "text": "不辞，几年后可能还在原地。", "highlights": [{"word": "还在原地", "color": "amber"}], "cues": {}, "sfx": [{"type": "tick", "level": "weak", "at": 0, "repeat": {"every": 15, "count": 6}}]},
    {"id": 33, "start": 2835, "end": 2895, "section": "ledger", "text": "离开，要面对孤独；", "highlights": [], "cues": {"drop": 10}, "sfx": [{"type": "thud", "level": "weak", "at": "drop"}]},
    {"id": 34, "start": 2895, "end": 3000, "section": "ledger", "text": "留下，可能一点点耗掉自尊和时间。", "highlights": [{"word": "自尊", "color": "amber"}, {"word": "时间", "color": "amber"}], "cues": {}, "sfx": [{"type": "sand", "level": "weak", "at": 0, "dur": 105, "density": 1.0}]},
    {"id": 35, "start": 3000, "end": 3090, "section": "ledger", "text": "其实，留下也在付钱。", "highlights": [{"word": "也在付钱", "color": "amber"}], "cues": {"tip": 6}, "sfx": [{"type": "heavyHit", "level": "strong", "at": "tip"}]},
    {"id": 36, "start": 3090, "end": 3180, "section": "installment", "text": "人能适应越来越窄的房间，", "highlights": [], "cues": {}, "sfx": [{"type": "glide", "level": "weak", "at": 0}]},
    {"id": 37, "start": 3180, "end": 3270, "section": "installment", "text": "最后把还能忍，当成还不算糟。", "highlights": [{"word": "还能忍", "color": "amber"}, {"word": "还不算糟", "color": "amber"}], "cues": {}, "sfx": [{"type": "pluck", "level": "weak", "at": 20}]},
    {"id": 38, "start": 3270, "end": 3345, "section": "installment", "text": "成熟，不是越来越能忍，", "highlights": [], "cues": {}, "sfx": [{"type": "pad", "level": "weak", "at": 15, "dur": 75}]},
    {"id": 39, "start": 3345, "end": 3435, "section": "installment", "text": "而是重新计算自己的忍耐。", "highlights": [{"word": "重新计算", "color": "cyan"}], "cues": {}, "sfx": [{"type": "pluckUp", "level": "mid", "at": 6}]},
    {"id": 40, "start": 3435, "end": 3495, "section": "installment", "text": "忍耐像分期付款，", "highlights": [], "cues": {}, "sfx": [{"type": "tick", "level": "weak", "at": 0, "repeat": {"every": 15, "count": 4}}]},
    {"id": 41, "start": 3495, "end": 3555, "section": "installment", "text": "每期付的，都是时间。", "highlights": [{"word": "时间", "color": "amber"}], "cues": {}, "sfx": [{"type": "tick", "level": "weak", "at": 0, "repeat": {"every": 15, "count": 4}}]},
    {"id": 42, "start": 3555, "end": 3615, "section": "installment", "text": "今天不为改变付账，", "highlights": [], "cues": {}, "sfx": [{"type": "glide", "level": "weak", "at": 0}]},
    {"id": 43, "start": 3615, "end": 3705, "section": "installment", "text": "以后的你，会替现在付另一笔。", "highlights": [], "cues": {"drop": 20}, "sfx": [{"type": "thud", "level": "mid", "at": "drop"}]},
    {"id": 44, "start": 3705, "end": 3795, "section": "close", "text": "推动改变的，未必是更多勇气，", "highlights": [], "cues": {}, "sfx": [{"type": "pad", "level": "weak", "at": 0, "dur": 90}]},
    {"id": 45, "start": 3795, "end": 3885, "section": "close", "text": "而是看清：留下，也是一种选择。", "highlights": [{"word": "也是一种选择", "color": "cyan"}], "cues": {}, "sfx": [{"type": "chord", "level": "mid", "at": 10}]},
    {"id": 46, "start": 3885, "end": 3990, "section": "close", "text": "不改变，也在决定你成为谁。", "highlights": [], "cues": {"shadow": 8}, "sfx": [{"type": "heavyHit", "level": "strong", "at": "shadow"}]},
    {"id": 47, "start": 3990, "end": 4095, "section": "close", "text": "不是劝你立刻离开，是先把账算清。", "highlights": [], "cues": {}, "sfx": [{"type": "glide", "level": "weak", "at": 0}]},
    {"id": 48, "start": 4095, "end": 4230, "section": "close", "text": "问问自己：五年后还这样，你愿意吗？", "highlights": [], "cues": {}, "sfx": [{"type": "pluck", "level": "weak", "at": 30}]},
    {"id": 49, "start": 4230, "end": 4290, "section": "close", "text": "谁痛苦谁改变，", "highlights": [], "cues": {}, "sfx": [{"type": "riser", "level": "weak", "at": 0, "dur": 60}]},
    {"id": 50, "start": 4290, "end": 4365, "section": "close", "text": "但不必等到最痛才转身。", "highlights": [{"word": "最痛", "color": "amber"}], "cues": {}, "sfx": [{"type": "riser", "level": "mid", "at": 0, "dur": 75}]},
    {"id": 51, "start": 4365, "end": 4500, "section": "close", "text": "看清了，就可以走。", "highlights": [{"word": "走", "color": "cyan"}], "cues": {"push": 10}, "sfx": [{"type": "openChord", "level": "strong", "at": "push"}]}
  ]
}
