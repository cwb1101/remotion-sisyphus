{
  "name": "remotion-don-quixote",
  "version": "0.1.0",
  "private": true,
  "description": "堂吉诃德 · 代码动画知识短片（Remotion）",
  "scripts": {
    "prestudio": "npm run assets",
    "studio": "remotion studio",
    "assets": "node scripts/gen-sfx.mjs && node scripts/gen-grain.mjs",
    "check": "node scripts/check-subtitles.mjs",
    "render:preview": "npm run assets && npm run check && remotion render Preview out/preview.mp4 --crf=18 --pixel-format=yuv420p",
    "frames": "bash scripts/extract-frames.sh out/preview.mp4 out/frames 2",
    "typecheck": "tsc --noEmit",
    "render:full": "bash scripts/render-full.sh out/don-quixote.mp4",
    "frames:full": "bash scripts/extract-frames.sh out/don-quixote.mp4 out/frames-full 2",
    "cover": "npm run assets && remotion still Cover publish/cover-3x4.png --image-format=png"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.2.6",
    "@fontsource/noto-serif-sc": "5.2.6",
    "@remotion/cli": "4.0.535",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
