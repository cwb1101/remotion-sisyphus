{
  "name": "remotion-sisyphus",
  "version": "0.1.0",
  "private": true,
  "description": "情感漠视 · Vibe 知识短片（Remotion 纯代码动画）",
  "scripts": {
    "studio": "remotion studio",
    "sfx": "python3 scripts/synth_sfx.py",
    "check": "tsx scripts/check-script.ts",
    "render:preview": "npm run sfx && npm run check && remotion render Preview out/preview.mp4",
    "qa": "bash scripts/qa.sh out/preview.mp4",
    "render:film": "bash scripts/render-film.sh",
    "qa:film": "bash scripts/qa.sh out/film.mp4",
    "mix": "npx tsx scripts/export-timeline.ts && python3 scripts/mix_audio.py"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@remotion/cli": "4.0.533",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "@types/react": "19.2.18",
    "tsx": "4.23.14",
    "typescript": "6.0.3"
  }
}
