    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
